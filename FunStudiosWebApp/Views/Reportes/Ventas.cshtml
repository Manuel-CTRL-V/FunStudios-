@model VentasViewModel
@{
    ViewData["Title"] = "Historial de Ventas";
}

<!-- Encabezado -->
<div class="flex flex-col sm:flex-row justify-between sm:items-end gap-stack-md mb-stack-lg">
    <div>
        <h2 class="text-headline-lg text-on-background">Historial de Ventas</h2>
        <p class="text-body-md text-on-surface-variant mt-1">Facturación por pases de día y membresías.</p>
    </div>

    <!-- Tarjetas de totales -->
    <div class="flex gap-gutter">
        <div class="bg-surface-container-lowest rounded-xl px-stack-lg py-stack-md shadow-soft text-center">
            <p class="font-label-sm uppercase tracking-wider text-on-surface-variant">Transacciones</p>
            <p class="text-headline-lg font-bold text-on-background">@Model.TotalVentas</p>
        </div>
        <div class="bg-primary-container rounded-xl px-stack-lg py-stack-md shadow-soft text-center">
            <p class="font-label-sm uppercase tracking-wider text-on-primary-container/70">Monto total</p>
            <p class="text-headline-lg font-bold text-on-primary-container">@Model.MontoTotal.ToString("C2")</p>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft mb-gutter">
    <form method="get" asp-controller="Reportes" asp-action="Ventas"
          class="grid grid-cols-1 md:grid-cols-3 gap-gutter items-end">
        <div class="flex flex-col gap-1">
            <label for="fechaInicio" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Desde</label>
            <input type="date" id="fechaInicio" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")"
                   class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 h-[48px] focus:outline-none" />
        </div>
        <div class="flex flex-col gap-1">
            <label for="fechaFin" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Hasta</label>
            <input type="date" id="fechaFin" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")"
                   class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 h-[48px] focus:outline-none" />
        </div>
        <button type="submit"
                class="h-[48px] flex items-center justify-center gap-2 bg-primary hover:bg-surface-tint text-on-primary font-label-lg rounded-full btn-press transition-all cursor-pointer">
            <span class="material-symbols-outlined">filter_alt</span> Aplicar filtros
        </button>
    </form>
</div>

<!-- Tabla de ventas -->
<div class="bg-surface-container-lowest rounded-xl shadow-soft overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left min-w-[760px]">
            <thead>
                <tr class="border-b border-surface-variant/50 bg-surface-bright/50 font-label-sm uppercase tracking-wider text-on-surface-variant">
                    <th class="px-gutter py-stack-md font-semibold pl-6">Fecha / Hora</th>
                    <th class="px-gutter py-stack-md font-semibold">Cliente</th>
                    <th class="px-gutter py-stack-md font-semibold">Concepto</th>
                    <th class="px-gutter py-stack-md font-semibold">Método de pago</th>
                    <th class="px-gutter py-stack-md font-semibold text-right pr-6">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Ventas.Any())
                {
                    <tr><td colspan="5" class="px-gutter py-gutter text-center text-outline">No hay ventas en el periodo seleccionado.</td></tr>
                }
                @foreach (var v in Model.Ventas)
                {
                    <tr class="border-b border-surface-variant/30 last:border-0 hover:bg-surface-container-low transition-colors">
                        <td class="px-gutter py-stack-md pl-6 whitespace-nowrap">@v.FechaVenta.ToString("dd/MM/yyyy h:mm tt")</td>
                        <td class="px-gutter py-stack-md">
                            <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@v.ClienteId"
                               class="font-bold text-primary hover:text-surface-tint">@v.NombreCliente</a>
                        </td>
                        <td class="px-gutter py-stack-md">@v.Descripcion</td>
                        <td class="px-gutter py-stack-md">
                            <span class="font-label-sm px-3 py-1 rounded-full bg-surface-container-high text-on-surface-variant border border-outline-variant/30">@v.MetodoPagoNombre</span>
                        </td>
                        <td class="px-gutter py-stack-md text-right pr-6 font-bold">@v.Monto.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
