@model List<ClienteListadoItemViewModel>
@{
    ViewData["Title"] = "Gestión de Clientes";
    ViewData["Busqueda"] = Context.Request.Query["busqueda"].ToString();
    ViewData["Estado"] = Context.Request.Query["estado"].ToString();
}

<!-- Encabezado de página -->
<div class="flex flex-col sm:flex-row justify-between sm:items-end gap-stack-md mb-stack-lg">
    <div>
        <h2 class="text-headline-lg text-on-background">Gestión de Clientes</h2>
        <p class="text-body-md text-on-surface-variant mt-1">Perfiles familiares y progreso de fidelidad.</p>
    </div>
    <div class="flex gap-stack-md">
        <a asp-controller="Clientes" asp-action="Index"
           class="flex items-center gap-2 px-6 py-2 bg-surface-container-high text-primary font-label-lg rounded-full hover:bg-surface-dim transition-colors shadow-soft">
            <span class="material-symbols-outlined">refresh</span> Ver todos
        </a>
        <a asp-controller="Clientes" asp-action="Crear"
           class="flex items-center gap-2 px-6 py-2 bg-primary text-on-primary font-label-lg rounded-full hover:bg-surface-tint btn-press transition-all shadow-soft">
            <span class="material-symbols-outlined">add</span> Nuevo Cliente
        </a>
    </div>
</div>

<!-- Filtros de estado -->
@{
    var busquedaActual = Context.Request.Query["busqueda"].ToString();
    string EstadoActual = Context.Request.Query["estado"].ToString();
    string ClasePill(string valor) =>
        EstadoActual == valor
            ? "bg-primary text-on-primary shadow-soft"
            : "bg-surface-container-high text-primary hover:bg-surface-dim transition-colors";
}
<div class="flex flex-wrap gap-stack-sm mb-gutter">
    <a asp-controller="Clientes" asp-action="Index" asp-route-busqueda="@busquedaActual" asp-route-estado=""
       class="px-gutter py-2 rounded-full font-label-lg @ClasePill("")">Todos</a>
    <a asp-controller="Clientes" asp-action="Index" asp-route-busqueda="@busquedaActual" asp-route-estado="dentro"
       class="px-gutter py-2 rounded-full font-label-lg flex items-center gap-unit @ClasePill("dentro")">
        <span class="w-2 h-2 rounded-full bg-tertiary inline-block"></span> Dentro del parque
    </a>
    <a asp-controller="Clientes" asp-action="Index" asp-route-busqueda="@busquedaActual" asp-route-estado="fuera"
       class="px-gutter py-2 rounded-full font-label-lg flex items-center gap-unit @ClasePill("fuera")">
        <span class="w-2 h-2 rounded-full bg-outline-variant inline-block"></span> Fuera
    </a>
</div>

<!-- Tabla principal -->
<div class="bg-surface-container-lowest rounded-xl p-6 shadow-soft border border-surface-variant/30">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[820px]">
            <thead>
                <tr class="border-b-2 border-surface-variant/50 text-on-surface-variant font-label-sm uppercase tracking-wider">
                    <th class="pb-4 pl-4 font-semibold">Nombre del Niño</th>
                    <th class="pb-4 font-semibold">Familia</th>
                    <th class="pb-4 font-semibold text-center">Checks de Fidelidad</th>
                    <th class="pb-4 font-semibold">Estado</th>
                    <th class="pb-4 font-semibold">Última Entrada</th>
                    <th class="pb-4 pr-4 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-container-margin text-center text-outline">
                            No se encontraron clientes con ese criterio.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr class="hover:bg-surface-container-low transition-colors group border-b border-surface-variant/30 last:border-0 @(c.EstaDentro ? "" : "opacity-90")">
                        <!-- Nombre + nota médica -->
                        <td class="py-4 pl-4">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold">@c.Inicial</div>
                                <div>
                                    <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@c.ClienteId"
                                       class="font-bold text-on-background hover:text-primary block">@c.Nombre (@c.Edad años)</a>
                                    @if (c.TieneNotaMedica)
                                    {
                                        <span class="font-label-sm text-on-surface-variant bg-[#ffb300]/15 text-[#b26a00] px-2 py-0.5 rounded-full mt-1 inline-block">
                                            Nota médica
                                        </span>
                                    }
                                    @if (c.EntradasGratisDisponibles > 0)
                                    {
                                        <span class="font-label-sm bg-secondary-fixed-dim/30 text-secondary px-2 py-0.5 rounded-full mt-1 ml-1 inline-block">
                                            @c.EntradasGratisDisponibles gratis
                                        </span>
                                    }
                                </div>
                            </div>
                        </td>

                        <!-- Familia -->
                        <td class="py-4">
                            <div>
                                <p class="text-on-surface-variant">Familia @c.ApellidosFamilia</p>
                                <span class="font-label-sm text-primary bg-primary/10 px-2 py-0.5 rounded-full inline-block mt-1">@(c.CodigoFamilia ?? "—")</span>
                            </div>
                        </td>

                        <!-- Checks de fidelidad (RF8) -->
                        <td class="py-4">
                            <div class="flex items-center justify-center gap-0.5 text-secondary">
                                @for (var i = 1; i <= c.ChecksParaPremio; i++)
                                {
                                    <span class="material-symbols-outlined @(i <= c.ConteoChecks ? "text-secondary" : "text-outline-variant")" style="font-size:18px;">star</span>
                                }
                                <span class="font-label-sm text-on-surface-variant ml-2">@c.ConteoChecks/@c.ChecksParaPremio</span>
                            </div>
                        </td>

                        <!-- Estado: dentro/fuera del parque -->
                        <td class="py-4">
                            @if (c.EstaDentro)
                            {
                                <span class="bg-tertiary-container/10 text-tertiary font-label-sm px-3 py-1 rounded-full border border-tertiary/20">Dentro</span>
                            }
                            else
                            {
                                <span class="bg-surface-variant/50 text-on-surface-variant font-label-sm px-3 py-1 rounded-full border border-outline-variant/30">Fuera</span>
                            }
                        </td>

                        <!-- Última visita -->
                        <td class="py-4 text-on-surface-variant">@c.UltimaEntradaTexto</td>

                        <!-- Acciones -->
                        <td class="py-4 pr-4 text-right whitespace-nowrap">
                            <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@c.ClienteId"
                               class="inline-flex p-2 text-primary hover:bg-primary/10 rounded-full transition-colors" title="Ver perfil">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                            <a asp-controller="Clientes" asp-action="Editar" asp-route-id="@c.ClienteId"
                               class="inline-flex p-2 text-[#b26a00] hover:bg-[#ffb300]/10 rounded-full transition-colors" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Conteo simple -->
    <div class="mt-6 text-on-surface-variant font-label-sm">
        Mostrando @Model.Count cliente(s)@(string.IsNullOrWhiteSpace(ViewData["Busqueda"]?.ToString()) ? "" : $" para “{ViewData["Busqueda"]}”")
    </div>
</div>
