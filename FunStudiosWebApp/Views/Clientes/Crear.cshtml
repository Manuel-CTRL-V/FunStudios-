@model ClienteCrearViewModel
@{
    ViewData["Title"] = "Registrar Cliente";
}

<!-- Encabezado -->
<div class="mb-stack-lg">
    <h2 class="text-display-lg text-on-surface mb-2">Registrar Cliente</h2>
    <p class="text-body-lg text-on-surface-variant">
        Vincule un niño a una familia registrada. Solo la familia es obligatoria; el resto de los datos puede completarse después.
    </p>
</div>

<form asp-controller="Clientes" asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div class="max-w-3xl mx-auto flex flex-col gap-gutter">

        <!-- 1. Familia (obligatoria) -->
        <div class="bg-surface-container-lowest rounded-[2rem] p-gutter shadow-soft">
            <div class="flex items-center gap-2 mb-stack-md">
                <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary-container text-sm">family_restroom</span>
                </div>
                <h3 class="text-headline-sm text-on-surface">1. Familia</h3>
            </div>

            <div class="flex flex-col gap-1">
                <label asp-for="FamiliaExistenteId" class="font-label-sm text-label-sm text-on-surface-variant ml-4">
                    Familia del cliente
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-primary">badge</span>
                    <select asp-for="FamiliaExistenteId"
                            class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full py-3 pl-12 pr-4 h-[48px] focus:outline-none transition-all">
                        <option value="">— Seleccione la familia —</option>
                        @foreach (var f in Model.FamiliasExistentes)
                        {
                            <option value="@f.FamiliaId">
                                @f.ApellidosFamilia@(f.CodigoFamilia is null ? "" : $" · {f.CodigoFamilia}") · @f.Etiqueta
                            </option>
                        }
                    </select>
                </div>
                <span asp-validation-for="FamiliaExistenteId" class="font-label-sm text-error ml-4"></span>

                <p class="font-label-sm text-on-surface-variant ml-4 mt-stack-sm">
                    ¿La familia aún no existe?
                    <a asp-controller="Familias" asp-action="Crear" class="text-primary hover:underline">Cree una nueva familia</a>
                    y luego registre al cliente.
                </p>
            </div>
        </div>

        <!-- 2. Info del niño (opcional) -->
        <div class="bg-surface-container-lowest rounded-[2rem] p-gutter shadow-soft">
            <div class="flex items-center gap-2 mb-stack-md">
                <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary-container text-sm">face</span>
                </div>
                <div>
                    <h3 class="text-headline-sm text-on-surface">2. Info del Niño</h3>
                    <p class="font-label-sm text-on-surface-variant">Todos los campos son opcionales.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                <div class="flex flex-col gap-1">
                    <label asp-for="Nombre" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Nombre del Niño</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-primary">smart_toy</span>
                        <input asp-for="Nombre" placeholder="ej. Leo"
                               class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full py-3 pl-12 pr-4 h-[48px] focus:outline-none transition-all placeholder:text-outline-variant" />
                    </div>
                    <span asp-validation-for="Nombre" class="font-label-sm text-error ml-4"></span>
                </div>

                <div class="flex flex-col gap-1">
                    <label asp-for="FechaNacimiento" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Fecha de Nacimiento</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-primary">cake</span>
                        <input asp-for="FechaNacimiento" type="date" max="@DateTime.Now.ToString("yyyy-MM-dd")"
                               class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full py-3 pl-12 pr-4 h-[48px] focus:outline-none transition-all" />
                    </div>
                    <span asp-validation-for="FechaNacimiento" class="font-label-sm text-error ml-4"></span>
                    <p class="font-label-sm text-on-surface-variant ml-4">Si no se registra, se mostrará como “Edad no registrada”.</p>
                </div>

                <div class="flex flex-col gap-1">
                    <label asp-for="Nacionalidad" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Nacionalidad (opcional)</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-primary">public</span>
                        <select asp-for="Nacionalidad"
                                class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full py-3 pl-12 pr-4 h-[48px] focus:outline-none transition-all">
                            @foreach (var n in Nacionalidades.Todas)
                            {
                                if ((Model.Nacionalidad ?? Nacionalidades.Default) == n)
                                {
                                    <option value="@n" selected>@n</option>
                                }
                                else
                                {
                                    <option value="@n">@n</option>
                                }
                            }
                        </select>
                    </div>
                    <span asp-validation-for="Nacionalidad" class="font-label-sm text-error ml-4"></span>
                </div>

                <div class="flex flex-col gap-1 md:col-span-2">
                    <label asp-for="NotasMedicas" class="font-label-sm text-label-sm text-on-surface-variant ml-4">Notas médicas (opcional)</label>
                    <textarea asp-for="NotasMedicas" rows="2" placeholder="Alergias, condiciones especiales..."
                              class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-[1rem] py-3 px-4 focus:outline-none transition-all placeholder:text-outline-variant"></textarea>
                </div>
            </div>
        </div>

        <!-- Resumen de errores del servidor -->
        <div asp-validation-summary="All" class="text-error font-label-md"></div>

        <!-- Botón final -->
        <div class="flex justify-end gap-stack-md">
            <a asp-controller="Clientes" asp-action="Index"
               class="flex items-center gap-2 px-6 py-2 bg-surface-container-high text-primary font-label-lg rounded-full hover:bg-surface-dim transition-colors shadow-soft">
                Cancelar
            </a>
            <button type="submit"
                    class="bg-primary hover:bg-surface-tint text-on-primary font-headline-sm px-8 rounded-full shadow-high btn-press transition-all duration-200 flex items-center gap-2 h-[64px] cursor-pointer">
                <span class="material-symbols-outlined">person_add</span>
                Registrar Cliente
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
