<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FunStudios</title>

    <!-- Tailwind compilado localmente (sin depender de internet en producción) -->
    <script src="~/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Tipografías: Nunito Sans + Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    "colors": {
                        "on-secondary": "#ffffff",
                        "primary-fixed": "#d3e4ff",
                        "error-container": "#ffdad6",
                        "tertiary-container": "#268630",
                        "secondary": "#b80049",
                        "secondary-container": "#e2165f",
                        "tertiary-fixed-dim": "#7ddc7a",
                        "primary-container": "#0077ce",
                        "surface-container-highest": "#cfe6f2",
                        "secondary-fixed": "#ffd9de",
                        "inverse-surface": "#1e333c",
                        "surface-container-high": "#d5ecf8",
                        "on-background": "#071e27",
                        "outline": "#707783",
                        "surface-container-lowest": "#ffffff",
                        "on-error": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "surface-container": "#dbf1fe",
                        "on-error-container": "#93000a",
                        "surface-tint": "#0060a8",
                        "outline-variant": "#c0c7d4",
                        "on-tertiary-container": "#f7fff1",
                        "surface-bright": "#f3faff",
                        "surface-dim": "#c7dde9",
                        "surface-variant": "#cfe6f2",
                        "tertiary": "#006b1b",
                        "tertiary-fixed": "#98f994",
                        "on-tertiary": "#ffffff",
                        "on-primary": "#ffffff",
                        "primary": "#005ea4",
                        "surface": "#f3faff",
                        "primary-fixed-dim": "#a2c9ff",
                        "on-surface": "#071e27",
                        "error": "#ba1a1a",
                        "on-surface-variant": "#404752",
                        "surface-container-low": "#e6f6ff",
                        "background": "#f3faff"
                    },
                    "borderRadius": {
                        DEFAULT: "1rem",
                        lg: "2rem",
                        xl: "3rem",
                        full: "9999px"
                    },
                    "spacing": {
                        "stack-sm": "8px",
                        "touch-target": "48px",
                        "stack-lg": "32px",
                        "stack-md": "16px",
                        gutter: "24px",
                        "container-margin": "32px",
                        unit: "8px"
                    },
                    "fontFamily": {
                        body: ["Nunito Sans"]
                    },
                    "fontSize": {
                        "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "700" }],
                        "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "700" }],
                        "label-lg": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "700" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "800" }],
                        "label-sm": ["12px", { lineHeight: "16px", fontWeight: "600" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full font-body text-body-md text-on-surface bg-background">
@{
    var autenticado = User.Identity!.IsAuthenticated;
    var esAdmin = User.IsInRole("Administrador");
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    var iniciales = string.Join("", (User.Identity.Name ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p[0]))
        .ToUpper();
}

@if (!autenticado)
{
    // Pantallas públicas (login): solo tarjeta centrada sobre fondo confetti
    <div class="confetti-bg fixed inset-0"></div>
    <main class="relative min-h-screen flex items-center justify-center px-container-margin">
        @RenderBody()
    </main>
}
else
{
    // Shell principal de la aplicación
    <div class="flex min-h-screen">

        <!-- ===== Sidebar ===== -->
        <nav class="hidden md:flex flex-col fixed left-0 top-0 h-full w-72 bg-surface-container-low shadow-sm z-40">
            <div class="p-gutter flex items-center gap-stack-sm">
                <img src="~/images/logo-funstudios.jpg" alt="FunStudios" class="w-10 h-10 rounded-lg object-cover" />
                <span class="text-headline-lg font-black text-secondary tracking-tight">FunStudios</span>
            </div>

            <div class="px-gutter pb-gutter flex items-center gap-stack-sm">
                <div class="w-9 h-9 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold">@iniciales</div>
                <div class="leading-tight">
                    <p class="font-label-lg text-label-lg text-on-surface">@User.Identity.Name</p>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">@(esAdmin ? "Administrador" : "Recepción")</p>
                </div>
            </div>

            <div class="flex-1 flex flex-col gap-stack-sm overflow-y-auto hide-scroll pt-stack-sm">
                <a asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center gap-stack-md px-gutter py-touch-target rounded-lg mx-stack-md transition-all btn-press @(controladorActual == "Dashboard" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="font-label-lg">Panel de Control</span>
                </a>

                <a asp-controller="Clientes" asp-action="Index"
                   class="flex items-center gap-stack-md px-gutter py-touch-target rounded-lg mx-stack-md transition-all btn-press @(controladorActual == "Clientes" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
                    <span class="material-symbols-outlined">fingerprint</span>
                    <span class="font-label-lg">Clientes</span>
                </a>

                <div class="mx-stack-md">
                    <button type="button" id="btn-reportes-toggle"
                            class="w-full flex items-center justify-between gap-stack-md px-gutter py-touch-target rounded-lg transition-all @(controladorActual == "Reportes" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
                        <span class="flex items-center gap-stack-md">
                            <span class="material-symbols-outlined">bar_chart</span>
                            <span class="font-label-lg">Reportes</span>
                        </span>
                        <span class="material-symbols-outlined transition-transform @(controladorActual == "Reportes" ? "rotate-90" : "")">chevron_right</span>
                    </button>
                    <div id="menu-reportes" class="hidden flex-col gap-1 mt-stack-sm pl-stack-md">
                        <a asp-controller="Reportes" asp-action="Bitacora"
                           class="flex items-center gap-2 px-gutter py-3 rounded-lg text-label-lg @(controladorActual == "Reportes" && accionActual == "Bitacora" ? "bg-primary text-on-primary" : "text-on-surface-variant hover:bg-surface-variant")">
                            <span class="material-symbols-outlined text-[18px]">history</span> Bitácora de Entradas
                        </a>
                        <a asp-controller="Reportes" asp-action="Ventas"
                           class="flex items-center gap-2 px-gutter py-3 rounded-lg text-label-lg @(controladorActual == "Reportes" && accionActual == "Ventas" ? "bg-primary text-on-primary" : "text-on-surface-variant hover:bg-surface-variant")">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span> Ventas y Facturas
                        </a>
                        <a asp-controller="Reportes" asp-action="InteligenciaNegocio"
                           class="flex items-center gap-2 px-gutter py-3 rounded-lg text-label-lg @(controladorActual == "Reportes" && accionActual == "InteligenciaNegocio" ? "bg-primary text-on-primary" : "text-on-surface-variant hover:bg-surface-variant")">
                            <span class="material-symbols-outlined text-[18px]">insights</span> Inteligencia de Negocio
                        </a>
                        <a asp-controller="Reportes" asp-action="LogsBiometrico"
                           class="flex items-center gap-2 px-gutter py-3 rounded-lg text-label-lg @(controladorActual == "Reportes" && accionActual == "LogsBiometrico" ? "bg-primary text-on-primary" : "text-on-surface-variant hover:bg-surface-variant")">
                            <span class="material-symbols-outlined text-[18px]">bug_report</span> Logs Biométricos
                        </a>
                    </div>
                </div>

                @if (esAdmin)
                {
                    <a asp-controller="Usuarios" asp-action="Index"
                       class="flex items-center gap-stack-md px-gutter py-touch-target rounded-lg mx-stack-md transition-all btn-press @(controladorActual == "Usuarios" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
                        <span class="material-symbols-outlined">group</span>
                        <span class="font-label-lg">Usuarios</span>
                    </a>
                }
            </div>

            <div class="p-gutter mt-auto">
                <a asp-controller="Clientes" asp-action="Crear"
                   class="w-full flex items-center justify-center gap-unit bg-secondary text-on-secondary font-label-lg py-touch-target rounded-full shadow-soft btn-press hover:bg-secondary-container transition-colors">
                    <span class="material-symbols-outlined">person_add</span>
                    Enrolar Nuevo Niño
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-stack-md">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full flex items-center justify-center gap-stack-sm text-on-surface-variant hover:text-error transition-colors py-stack-sm font-label-lg">
                        <span class="material-symbols-outlined">logout</span>
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </nav>

        <!-- ===== Contenido principal ===== -->
        <main class="flex-1 md:ml-72 min-h-screen dots-bg">
            <header class="flex justify-between items-center w-full px-container-margin py-stack-md sticky top-0 bg-surface/90 backdrop-blur z-30">
                <h1 class="text-headline-md font-extrabold text-primary">FunStudios</h1>

                <form asp-controller="Clientes" asp-action="Index" method="get" class="flex items-center gap-stack-md">
                    <div class="relative hidden sm:block">
                        <span class="material-symbols-outlined absolute left-stack-sm top-1/2 -translate-y-1/2 text-outline pointer-events-none">search</span>
                        <input name="busqueda" value="@ViewData["Busqueda"]"
                               class="pl-10 pr-4 py-2 bg-surface-container-high border-2 border-transparent focus:border-primary rounded-full w-64 focus:outline-none placeholder:text-outline-variant"
                               placeholder="Buscar familias o niños..." />
                    </div>

                    <div class="w-10 h-10 rounded-full border-2 border-primary-container bg-primary-container text-on-primary-container flex items-center justify-center font-bold" title="@User.Identity.Name">
                        @iniciales
                    </div>
                </form>
            </header>

            <div class="p-container-margin pt-stack-md pb-container-margin max-w-[1400px] mx-auto">
                @RenderBody()
            </div>
        </main>
    </div>

    @Html.AntiForgeryToken()
}

<!-- ===== Toast de notificaciones (TempData) ===== -->
@if (TempData["Mensaje"] != null)
{
    <div class="toast-notification toast-success" data-autohide="true">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-notification toast-error">@TempData["Error"]</div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    // Toast dinámico reutilizable para las vistas que operan por AJAX
    function toast(mensaje, esError = false) {
        const t = document.createElement('div');
        t.className = 'toast-notification ' + (esError ? 'toast-error' : 'toast-success');
        t.textContent = mensaje;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 5000);
    }

    // Auto-ocultar los toasts después de unos segundos
    document.querySelectorAll('.toast-notification').forEach(function (t) {
        setTimeout(function () { t.remove(); }, 6000);
    });

    // Submenú de reportes
    const btnReportes = document.getElementById('btn-reportes-toggle');
    if (btnReportes) {
        const menu = document.getElementById('menu-reportes');
        if (menu.classList.contains('hidden') && menu.querySelector('.bg-primary')) {
            menu.classList.remove('hidden');
            menu.classList.add('flex');
        }
        btnReportes.addEventListener('click', function () {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            btnReportes.querySelector('.transition-transform')?.classList.toggle('rotate-90');
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
