@model List<FamiliaListadoItemViewModel>
@{
    ViewData["Title"] = "Familias";
    ViewData["Busqueda"] = Context.Request.Query["busqueda"].ToString();
}

<!-- Encabezado de página -->
<div class="flex flex-col sm:flex-row justify-between sm:items-end gap-stack-md mb-stack-lg">
    <div>
        <h2 class="text-headline-lg text-on-background">Familias</h2>
        <p class="text-body-md text-on-surface-variant mt-1">Grupos familiares, sus tutores y niños asociados.</p>
    </div>
    <div class="flex gap-stack-md">
        <a asp-controller="Familias" asp-action="Index"
           class="flex items-center gap-2 px-6 py-2 bg-surface-container-high text-primary font-label-lg rounded-full hover:bg-surface-dim transition-colors shadow-soft">
            <span class="material-symbols-outlined">refresh</span> Ver todos
        </a>
    </div>
</div>

<!-- Filtros de estado -->
@{
    var busquedaActual = Context.Request.Query["busqueda"].ToString();
    string EstadoActual = Context.Request.Query["estado"].ToString();
    string ClasePill(string valor) =>
        EstadoActual == valor
            ? "bg-primary text-on-primary shadow-soft"
            : "bg-surface-container-high text-primary hover:bg-surface-dim transition-colors";
}

<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-gutter">
    <div class="flex flex-col gap-1 md:w-1/2">
        <form asp-controller="Familias" asp-action="Index" method="get" class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-4 text-primary">search</span>
            <input type="text" name="busqueda" value="@busquedaActual" placeholder="Buscar por apellidos o código (ej. FAM-001)"
                   class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-full py-3 pl-12 pr-24 h-[48px] focus:outline-none transition-all placeholder:text-outline-variant" />
            <button type="submit"
                    class="absolute right-2 px-4 py-1.5 rounded-full bg-primary text-on-primary font-label-lg hover:bg-surface-tint btn-press transition-all">
                Buscar
            </button>
        </form>
    </div>
    <div class="flex flex-wrap gap-stack-sm items-end justify-start md:justify-end">
        <a asp-controller="Familias" asp-action="Index" asp-route-busqueda="@busquedaActual" asp-route-estado=""
           class="px-gutter py-2 rounded-full font-label-lg @ClasePill("")">Todas</a>
        <a asp-controller="Familias" asp-action="Index" asp-route-busqueda="@busquedaActual" asp-route-estado="con_ninos_dentro"
           class="px-gutter py-2 rounded-full font-label-lg flex items-center gap-unit @ClasePill("con_ninos_dentro")">
            <span class="w-2 h-2 rounded-full bg-tertiary inline-block"></span> Con niños dentro
        </a>
    </div>
</div>

<!-- Tabla principal -->
<div class="bg-surface-container-lowest rounded-xl p-6 shadow-soft border border-surface-variant/30">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[820px]">
            <thead>
                <tr class="border-b-2 border-surface-variant/50 text-on-surface-variant font-label-sm uppercase tracking-wider">
                    <th class="pb-4 pl-4 font-semibold">Familia</th>
                    <th class="pb-4 font-semibold">Tutores</th>
                    <th class="pb-4 font-semibold text-center">Niños</th>
                    <th class="pb-4 font-semibold text-center">Dentro</th>
                    <th class="pb-4 font-semibold">Huella tutor</th>
                    <th class="pb-4 pr-4 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-container-margin text-center text-outline">
                            No se encontraron familias con ese criterio.
                        </td>
                    </tr>
                }
                @foreach (var f in Model)
                {
                    <tr class="hover:bg-surface-container-low transition-colors group border-b border-surface-variant/30 last:border-0">
                        <!-- Familia -->
                        <td class="py-4 pl-4">
                            <a asp-controller="Familias" asp-action="Detalles" asp-route-id="@f.FamiliaId"
                               class="font-bold text-on-background hover:text-primary">@f.ApellidosFamilia</a>
                            <span class="font-label-sm text-primary bg-primary/10 px-2 py-0.5 rounded-full inline-block mt-1 ml-2">@(f.CodigoFamilia ?? "—")</span>
                        </td>

                        <!-- Tutores -->
                        <td class="py-4">
                            <p class="font-bold text-on-surface">@f.CantidadTutores @(f.CantidadTutores == 1 ? "tutor" : "tutores")</p>
                            <p class="text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">person</span>
                                @f.TutoresTexto
                            </p>
                        </td>

                        <!-- Niños -->
                        <td class="py-4 text-center font-bold text-on-surface">@f.CantidadNinos</td>

                        <!-- Dentro -->
                        <td class="py-4 text-center">
                            @if (f.NinosDentro > 0)
                            {
                                <span class="bg-tertiary-container/10 text-tertiary font-label-sm px-3 py-1 rounded-full border border-tertiary/20">@f.NinosDentro dentro</span>
                            }
                            else
                            {
                                <span class="bg-surface-variant/50 text-on-surface-variant font-label-sm px-3 py-1 rounded-full border border-outline-variant/30">—</span>
                            }
                        </td>

                        <!-- Huella del tutor -->
                        <td class="py-4">
                            @if (f.HuellaTutorEnrolada)
                            {
                                <span class="font-label-sm bg-secondary-fixed-dim/30 text-secondary px-3 py-1 rounded-full whitespace-nowrap">
                                    Enrolada ✓ <span class="font-bold">(@f.TutorConHuellaNombre)</span>
                                </span>
                            }
                            else
                            {
                                <span class="text-outline">Sin enrolar</span>
                            }
                        </td>

                        <!-- Acciones -->
                        <td class="py-4 pr-4 text-right whitespace-nowrap">
                            <a asp-controller="Familias" asp-action="Detalles" asp-route-id="@f.FamiliaId"
                               class="inline-flex p-2 text-primary hover:bg-primary/10 rounded-full transition-colors" title="Ver perfil">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                            <a asp-controller="Clientes" asp-action="Crear" asp-route-familiaId="@f.FamiliaId"
                               class="inline-flex p-2 text-[#b26a00] hover:bg-[#ffb300]/10 rounded-full transition-colors" title="Agregar niño a esta familia">
                                <span class="material-symbols-outlined">person_add</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Conteo simple -->
    <div class="mt-6 text-on-surface-variant font-label-sm">
        Mostrando @Model.Count familia(s)@(string.IsNullOrWhiteSpace(busquedaActual) ? "" : $" para “{busquedaActual}”")
    </div>
</div>