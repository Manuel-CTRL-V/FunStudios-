@model DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">

    <!-- ===== Columna izquierda: Checkpoint biométrico (RF5) ===== -->
    <div class="md:col-span-4 flex flex-col gap-gutter">

        <!-- Tarjeta de escaneo -->
        <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft border-2 border-surface-variant relative overflow-hidden">
            <div class="absolute inset-0 bg-primary opacity-5"></div>

            <h2 class="relative text-headline-sm text-primary mb-stack-md flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">settings_remote</span>
                Escanear Huella
            </h2>

            <!-- Estado: esperando -->
            <div id="scan-idle" class="relative flex flex-col items-center py-stack-md">
                <button type="button" onclick="escanear()"
                        class="w-48 h-48 bg-surface-container-high rounded-full flex items-center justify-center pulse-ring border-4 border-apple-green cursor-pointer btn-press"
                        style="border-color:#7ddc7a; color:#268630;"
                        title="Simular lectura de huella">
                    <span class="material-symbols-outlined" style="font-size:80px;">fingerprint</span>
                </button>
                <p class="text-body-lg text-on-surface font-bold mt-stack-md">Esperando entrada...</p>
                <p class="font-label-sm text-label-sm text-on-surface-variant mt-unit">Coloque el dedo del niño en el escáner</p>
            </div>

            <!-- Estado: escaneando -->
            <div id="scan-loading" class="relative hidden flex-col items-center py-container-margin">
                <div class="w-40 h-40 rounded-full border-4 border-[#ffda6a] flex items-center justify-center pulse-ring-wait bg-surface-bright">
                    <span class="material-symbols-outlined text-[64px] text-outline-variant">fingerprint</span>
                </div>
                <p class="text-label-lg font-bold mt-stack-md">Identificando...</p>
                <p class="font-label-sm text-on-surface-variant mt-unit">Comparando template en la base biométrica</p>
            </div>

            <!-- Estado: resultado -->
            <div id="scan-result" class="relative hidden flex-col gap-stack-md">
                <div id="result-error" class="hidden items-center gap-2 bg-error-container text-on-error-container font-label-lg px-gutter py-stack-md rounded-lg border border-error/30">
                    <span class="material-symbols-outlined">fingerprint_off</span>
                    <span id="result-error-msg"></span>
                </div>

                <div id="result-cliente" class="hidden flex-col gap-stack-md">
                    <div class="flex items-center gap-stack-md">
                        <div id="result-avatar" class="w-14 h-14 rounded-full bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center font-black text-headline-sm"></div>
                        <div class="leading-tight">
                            <p id="result-nombre" class="text-headline-sm text-on-surface"></p>
                            <p id="result-familia" class="font-label-sm text-on-surface-variant"></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-stack-sm">
                        <div class="bg-surface-container-low rounded-lg p-stack-sm text-center">
                            <p class="font-label-sm uppercase tracking-wider text-on-surface-variant">Edad</p>
                            <p id="result-edad" class="text-headline-sm font-extrabold text-on-surface"></p>
                        </div>
                        <div class="bg-surface-container-low rounded-lg p-stack-sm text-center">
                            <p class="font-label-sm uppercase tracking-wider text-on-surface-variant">Checks</p>
                            <div id="result-checks" class="flex items-center justify-center gap-0.5 text-secondary"></div>
                        </div>
                    </div>

                    <div id="result-checks-hoy" class="hidden items-center justify-center gap-1 bg-surface-container-low rounded-full px-stack-md py-unit font-label-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-[16px]">today</span>
                        <span id="result-checks-hoy-txt"></span>
                    </div>

                    <!-- Nota médica -->
                    <div id="result-nota" class="hidden items-start gap-2 bg-surface-container-high border-l-8 border-[#ffb300] px-gutter py-3 rounded-lg">
                        <span class="material-symbols-outlined text-[#b26a00]">medical_information</span>
                        <div>
                            <p class="font-label-sm uppercase tracking-wider text-on-surface-variant">Nota médica</p>
                            <p id="result-nota-txt" class="font-label-lg text-on-surface"></p>
                        </div>
                    </div>

                    <!-- Dentro del parque: registrar salida (RF7) -->
                    <div id="result-dentro" class="hidden flex-col gap-stack-md bg-tertiary-container/10 border border-tertiary/20 rounded-lg p-stack-md">
                        <p class="font-label-lg text-tertiary flex items-center gap-2">
                            <span class="material-symbols-outlined">door_front</span>
                            Está dentro desde las <b id="result-hora-entrada"></b>
                        </p>
                        <button type="button" onclick="registrarSalida()"
                                class="w-full h-touch-target bg-secondary text-on-secondary font-label-lg rounded-lg hover:bg-secondary-container btn-press shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">logout</span> Registrar Salida
                        </button>
                    </div>

                    <!-- Fuera del parque: opciones de entrada (RF6, RF8) -->
                    <form id="form-entrada" onsubmit="registrarEntrada(event)" class="hidden flex-col gap-stack-md">
                        <p class="font-label-lg text-on-surface-variant">Tipo de acceso para la entrada:</p>
                        <div id="opciones-acceso" class="flex flex-col gap-stack-sm"></div>

                        <div id="pago-section" class="hidden grid grid-cols-2 gap-stack-sm">
                            <select id="metodo-pago" class="bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 focus:outline-none">
                                <option value="" disabled selected>Método de pago</option>
                                <option value="1">Efectivo</option>
                                <option value="2">Tarjeta</option>
                                <option value="3">Transferencia</option>
                            </select>
                            <input id="monto" type="number" step="1" min="0" value="400"
                                   class="bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 focus:outline-none" />
                        </div>

                        <div class="flex flex-col gap-stack-sm">
                            <label class="font-label-sm text-on-surface-variant ml-4">¿Quiénes acompañaron al niño?</label>
                            <div class="flex flex-col gap-2" id="tutor-checks">
                                <!-- los tutores de la familia se pintan dinámicamente -->
                            </div>

                            <label class="flex items-center gap-stack-sm border-2 border-surface-variant hover:border-primary rounded-lg p-stack-sm cursor-pointer transition-colors">
                                <input type="checkbox" id="chk-otro" onchange="toggleTutorOtro()" class="accent-[#0077ce]" />
                                <span class="font-label-lg text-on-surface">Acompañante no registrado (abuela, tía...)</span>
                            </label>

                            <!-- Campos para acompañante no registrado -->
                            <div id="tutor-otro-campos" class="hidden flex-col gap-stack-sm mt-unit pl-stack-md border-l-2 border-outline-variant/30">
                                <div class="flex flex-col gap-1">
                                    <label for="tutor-otro-nombre" class="font-label-sm text-on-surface-variant ml-4">Nombre <b>(obligatorio)</b></label>
                                    <input id="tutor-otro-nombre" placeholder="ej. Abuela Rosa"
                                           class="bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 focus:outline-none placeholder:text-outline-variant" />
                                </div>
                                <div class="flex flex-col gap-1">
                                    <label for="tutor-otro-telefono" class="font-label-sm text-on-surface-variant ml-4">Teléfono <b class="text-outline">(opcional)</b></label>
                                    <input id="tutor-otro-telefono" placeholder="8090000000" type="tel" inputmode="numeric" maxlength="12" oninput="formatTelefono(this)"
                                           class="bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 focus:outline-none placeholder:text-outline-variant" />
                                </div>
                            </div>

                            <!-- Cantidad de acompañantes (incluye tutores) -->
                            <div class="flex flex-col gap-1 mt-unit">
                                <label for="acompanantes" class="font-label-sm text-on-surface-variant ml-4">Cantidad de acompañantes <b>(incluye tutores)</b></label>
                                <input id="acompanantes" type="number" min="0" value="0" oninput="onInputAcompanantes()"
                                       class="bg-surface-container border-2 border-transparent focus:border-primary rounded-full px-4 py-3 focus:outline-none" />
                                <span class="font-label-sm text-on-surface-variant ml-4">Se actualiza con cada tutor marcado; súbelo para acompañantes extra no listados.</span>
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full h-touch-target bg-primary text-on-primary font-label-lg rounded-lg hover:bg-surface-tint btn-press shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">verified</span> Confirmar Entrada
                        </button>
                    </form>

                    <button type="button" onclick="resetScanner()"
                            class="self-center text-label-lg text-outline hover:text-primary transition-colors py-stack-sm flex items-center gap-unit cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">restart_alt</span> Nueva lectura
                    </button>
                </div>
            </div>
        </div>

        <!-- Escaneos recientes -->
        <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft flex flex-col">
            <div class="flex justify-between items-center mb-stack-md">
                <h3 class="text-headline-sm text-on-surface">Escaneos Recientes</h3>
                <span class="material-symbols-outlined text-on-surface-variant">history</span>
            </div>
            <ul id="lista-recientes" class="flex flex-col gap-stack-sm">
                @if (!Model.EscaneosRecientes.Any())
                {
                    <li class="font-label-lg text-outline py-stack-sm">Aún no hay movimientos registrados hoy.</li>
                }
                @foreach (var m in Model.EscaneosRecientes)
                {
                    <li class="flex items-center gap-stack-sm p-stack-sm hover:bg-surface-container-low rounded-lg transition-colors">
                        <div class="w-10 h-10 @(m.EsEntrada ? "bg-primary-fixed text-on-primary-fixed" : "bg-secondary-fixed text-on-secondary-fixed") rounded-full flex items-center justify-center font-bold">@m.Inicial</div>
                        <div class="flex-1 leading-tight">
                            <p class="font-label-lg text-on-surface">@m.NombreCliente</p>
                            <p class="font-label-sm text-on-surface-variant">@m.EtiquetaMovimiento • @m.Hora.ToString("h:mm tt")</p>
                        </div>
                        <span class="material-symbols-outlined @(m.EsEntrada ? "text-tertiary" : "text-secondary")">@(m.EsEntrada ? "check_circle" : "output")</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- ===== Columna derecha: métricas (RF13) ===== -->
    <div class="md:col-span-8 flex flex-col gap-gutter">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter">

            <!-- Niños dentro del parque -->
            <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft border-t-8 flex flex-col justify-between" style="border-top-color:#0077ce;">
                <div class="flex justify-between items-start mb-stack-sm">
                    <span class="font-label-lg uppercase tracking-wider text-on-surface-variant">Niños en el parque</span>
                    <span class="material-symbols-outlined text-primary-container">toys</span>
                </div>
                <div class="flex items-end gap-stack-sm">
                    <span class="text-display-lg text-on-surface">@Model.NinosDentro</span>
                    <span class="text-body-md text-tertiary font-bold mb-2">/ @Model.CapacidadMaxima</span>
                </div>
            </div>

            <!-- Day Passes de hoy -->
            <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft border-t-8 flex flex-col justify-between" style="border-top-color:#7ddc7a;">
                <div class="flex justify-between items-start mb-stack-sm">
                    <span class="font-label-lg uppercase tracking-wider text-on-surface-variant">Pases de día hoy</span>
                    <span class="material-symbols-outlined" style="color:#43A047;">local_activity</span>
                </div>
                <div class="flex items-end gap-stack-sm">
                    <span class="text-display-lg text-on-surface">@Model.DayPassesHoy</span>
                    <span class="text-body-md text-tertiary font-bold mb-2">@Model.IngresosDayPassHoy.ToString("C0")</span>
                </div>
            </div>

            <!-- Entradas gratis por fidelidad -->
            <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft border-t-8 flex flex-col justify-between" style="border-top-color:#e2165f;">
                <div class="flex justify-between items-start mb-stack-sm">
                    <span class="font-label-lg uppercase tracking-wider text-on-surface-variant">Entradas gratis fidelidad</span>
                    <span class="material-symbols-outlined text-secondary-container">stars</span>
                </div>
                <div class="flex items-end gap-stack-md">
                    <span class="text-display-lg text-on-surface font-extrabold">@Model.GratisCanjeadasTotal</span>
                    <div class="leading-none mb-2">
                        <span class="text-headline-sm font-bold text-secondary">+@Model.GratisDisponiblesSaldo</span>
                        <span class="block font-label-sm text-on-surface-variant">por canjear</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado del lector biométrico (se actualiza en vivo por polling) -->
        <div class="bg-surface-container-lowest rounded-xl p-gutter shadow-soft flex items-center justify-between">
            <div class="flex items-center gap-stack-md">
                <span id="lector-icono" class="material-symbols-outlined @(Model.LectorConectado ? "text-tertiary" : "text-error")">sensors</span>
                <div class="leading-tight">
                    <p class="font-label-lg text-on-surface"><span id="lector-nombre">@Model.LectorNombre</span></p>
                    <p class="font-label-sm text-on-surface-variant">Servicio biométrico en la PC de recepción via red</p>
                </div>
            </div>
            <span id="lector-estado-badge" class="font-label-lg px-3 py-1 rounded-full @(Model.LectorConectado ? "bg-tertiary-container/10 text-tertiary border border-tertiary/20" : "bg-error-container text-on-error-container border border-error/20")">
                @(Model.LectorConectado ? "Conectado" : "Desconectado")
            </span>
        </div>
    </div>
</div>

<!-- ===== Modal de premio: ¡entrada gratis ganada! (RF10) ===== -->
<div id="modal-premio" class="hidden fixed inset-0 z-50 items-center justify-center bg-inverse-surface/60 backdrop-blur-sm">
    <div class="bg-surface-container-lowest rounded-xl p-container-margin max-w-md w-full mx-4 relative overflow-hidden text-center shadow-high">
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-secondary via-[#ffda6a] to-tertiary-fixed-dim"></div>
        <div class="mt-stack-lg mb-stack-md flex justify-center">
            <div class="w-28 h-28 rounded-full bg-secondary-fixed flex items-center justify-center pulse-ring" style="color:#b80049;">
                <span class="material-symbols-outlined text-[64px]">celebration</span>
            </div>
        </div>
        <h3 class="text-headline-md text-secondary">¡Entrada Gratis Ganada!</h3>
        <p class="text-body-lg text-on-surface-variant mt-stack-sm">
            <b id="premio-nombre"></b> completó sus @Model.ChecksParaPremio visitas.
            Se acreditó <b>1 entrada gratis</b> y su ciclo de fidelidad reinició a 0 checks.
        </p>
        <button type="button" onclick="cerrarPremio()"
                class="mt-stack-lg w-full h-touch-target bg-secondary text-on-secondary font-label-lg rounded-full hover:bg-secondary-container btn-press shadow-sm transition-all cursor-pointer">
            ¡Genial!
        </button>
    </div>
</div>

@section Scripts {
<script>
    function formatTelefono(el) {
        let v = el.value.replace(/\D/g, '').substring(0, 10);
        if (v.length > 6) v = v.substring(0, 3) + '-' + v.substring(3, 6) + '-' + v.substring(6);
        else if (v.length > 3) v = v.substring(0, 3) + '-' + v.substring(3);
        el.value = v;
    }

    // ================= Checkpoint biométrico simulado (RF5-RF10) =================
    const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;

    async function postJson(url, body) {
        const resp = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify(body || {})
        });
        return resp.json();
    }

    function mostrar(id) {
        ['scan-idle', 'scan-loading', 'scan-result'].forEach(s => {
            const el = document.getElementById(s);
            el.classList.add('hidden');
            if (s === id) el.classList.remove('hidden');
        });
    }

    function resetScanner() { mostrar('scan-idle'); }

    async function escanear() {
        // El checkpoint identifica el dedo que se coloca en el lector contra la base
        // de datos (1:N). No hay modo simulación.
        mostrar('scan-loading');

        setTimeout(async () => {
            try {
                const data = await postJson('/Acceso/Escanear', {});
                pintarResultado(data);
            } catch {
                document.getElementById('result-error-msg').textContent = 'Error al comunicarse con el lector. Verifique que el servicio biométrico esté activo.';
                document.getElementById('result-error').classList.remove('hidden');
                document.getElementById('result-cliente').classList.add('hidden');
                mostrar('scan-result');
            }
        }, 700);
    }

    function estrellas(conteo, total) {
        total = total || 8;
        let html = '';
        for (let i = 1; i <= total; i++) {
            html += `<span class="material-symbols-outlined ${i <= conteo ? 'text-secondary' : 'text-outline-variant'}" style="font-size:18px;">star</span>`;
        }
        return html + `<span class="font-label-sm text-on-surface-variant ml-1">${conteo}/${total}</span>`;
    }

    function pintarResultado(data) {
        const errorBox = document.getElementById('result-error');
        const clienteBox = document.getElementById('result-cliente');

        if (!data.encontrado) {
            document.getElementById('result-error-msg').textContent = data.mensaje;
            errorBox.classList.remove('hidden'); errorBox.classList.add('flex');
            clienteBox.classList.add('hidden');
            mostrar('scan-result');
            return;
        }

        errorBox.classList.add('hidden'); errorBox.classList.remove('flex');
        clienteBox.classList.remove('hidden'); clienteBox.classList.add('flex');

        document.getElementById('result-avatar').textContent = data.inicial;
        document.getElementById('result-nombre').textContent = `${data.nombre} · ${data.edad} años`;
        document.getElementById('result-familia').textContent = `Familia ${data.apellidosFamilia}`;
        document.getElementById('result-edad').textContent = `${data.edad} años`;
        document.getElementById('result-checks').innerHTML = estrellas(data.conteoChecks, data.checksParaPremio);

        const checksHoyBox = document.getElementById('result-checks-hoy');
        if (typeof data.checksSumadosHoy === 'number') {
            document.getElementById('result-checks-hoy-txt').textContent =
                `Checks sumados hoy: ${data.checksSumadosHoy} de ${data.checksPorDia}`;
            checksHoyBox.classList.remove('hidden'); checksHoyBox.classList.add('flex');
        } else {
            checksHoyBox.classList.add('hidden'); checksHoyBox.classList.remove('flex');
        }

        const notaBox = document.getElementById('result-nota');
        if (data.notasMedicas) {
            document.getElementById('result-nota-txt').textContent = data.notasMedicas;
            notaBox.classList.remove('hidden'); notaBox.classList.add('flex');
        } else {
            notaBox.classList.add('hidden'); notaBox.classList.remove('flex');
        }

        const dentroBox = document.getElementById('result-dentro');
        const formEntrada = document.getElementById('form-entrada');

        if (data.estaDentro) {
            document.getElementById('result-hora-entrada').textContent =
                new Date(data.horaEntradaActual).toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' });
            dentroBox.classList.remove('hidden'); dentroBox.classList.add('flex');
            formEntrada.classList.add('hidden'); formEntrada.classList.remove('flex');
        } else {
            dentroBox.classList.add('hidden'); dentroBox.classList.remove('flex');
            formEntrada.classList.remove('hidden'); formEntrada.classList.add('flex');
            pintarOpciones(data);
            pintarTutores(data);
        }

        window.clienteActual = data;
        mostrar('scan-result');
    }

    function pintarOpciones(data) {
        const cont = document.getElementById('opciones-acceso');
        cont.innerHTML = '';

        data.opcionesEntrada.forEach((op, i) => {
            const label = document.createElement('label');
            label.className = 'flex items-center gap-stack-sm border-2 border-surface-variant hover:border-primary rounded-lg p-stack-sm cursor-pointer transition-colors';
            label.innerHTML = `
                <input type="radio" name="tipo-acceso" value="${op.tipoAccesoId}" data-requiere-pago="${op.requierePago}" ${i === 0 ? 'checked' : ''} onchange="togglePago()" class="accent-[#0077ce]" />
                <span class="flex-1">
                    <span class="block font-label-lg text-on-surface">${op.nombre}</span>
                    <span class="block font-label-sm text-on-surface-variant">${op.descripcion}</span>
                </span>`;
            cont.appendChild(label);
        });

        togglePago();
    }

    function togglePago() {
        const sel = document.querySelector('input[name="tipo-acceso"]:checked');
        const requiere = sel?.dataset.requierePago === 'true';
        const pagoSection = document.getElementById('pago-section');
        pagoSection.classList.toggle('hidden', !requiere);
        document.getElementById('metodo-pago').required = requiere;
    }

    function toggleTutorOtro() {
        const esOtro = document.getElementById('chk-otro').checked;
        document.getElementById('tutor-otro-campos').classList.toggle('hidden', !esOtro);
        document.getElementById('tutor-otro-campos').classList.toggle('flex', esOtro);
        recalcularAcompanantes();
    }

    // Acompañantes extra que el usuario escribe a mano sobre el mínimo de tutores.
    let ajusteManual = 0;

    function baseAcompanantes() {
        return document.querySelectorAll('.tutor-check:checked').length +
            (document.getElementById('chk-otro').checked ? 1 : 0);
    }

    function onInputAcompanantes() {
        const input = document.getElementById('acompanantes');
        ajusteManual = Math.max(0, (input.valueAsNumber || 0) - baseAcompanantes());
    }

    function recalcularAcompanantes() {
        const input = document.getElementById('acompanantes');
        input.value = baseAcompanantes() + ajusteManual;
    }

    function pintarTutores(data) {
        const cont = document.getElementById('tutor-checks');
        cont.innerHTML = '';

        (data.tutores || []).forEach(t => {
            const label = document.createElement('label');
            label.className = 'flex items-center gap-stack-sm border-2 border-surface-variant hover:border-primary rounded-lg p-stack-sm cursor-pointer transition-colors';
            label.innerHTML = `
                <input type="checkbox" class="tutor-check accent-[#0077ce]" value="${t.tutorId}" ${t.esPrincipal ? 'checked' : ''} onchange="recalcularAcompanantes()" />
                <span class="flex-1">
                    <span class="block font-label-lg text-on-surface">${t.nombre}</span>
                    <span class="block font-label-sm text-on-surface-variant">${t.telefono || ''}${t.esPrincipal ? ' · principal' : ''}</span>
                </span>`;
            cont.appendChild(label);
        });

        if ((data.tutores || []).length === 0) {
            cont.innerHTML = '<p class="font-label-sm text-on-surface-variant">Esta familia aún no tiene tutores registrados.</p>';
        }

        document.getElementById('chk-otro').checked = false;
        ajusteManual = 0;
        toggleTutorOtro();
        recalcularAcompanantes();
    }

    async function registrarEntrada(ev) {
        ev.preventDefault();
        const sel = document.querySelector('input[name="tipo-acceso"]:checked');
        const tutorIds = Array.from(document.querySelectorAll('.tutor-check:checked')).map(c => parseInt(c.value));
        const conOtro = document.getElementById('chk-otro').checked;
        const baseAcomp = tutorIds.length + (conOtro ? 1 : 0);

        const body = {
            clienteId: window.clienteActual.clienteId,
            tipoAccesoId: parseInt(sel.value),
            metodoPagoId: sel.dataset.requierePago === 'true'
                ? parseInt(document.getElementById('metodo-pago').value) || null : null,
            monto: parseInt(document.getElementById('monto').value) || 0,
            tutorIds: tutorIds,
            acompanantes: parseInt(document.getElementById('acompanantes').value) || baseAcomp,
            tutorOtroNombre: conOtro ? document.getElementById('tutor-otro-nombre').value || null : null,
            tutorOtroTelefono: conOtro ? document.getElementById('tutor-otro-telefono').value || null : null
        };

        const data = await postJson('/Acceso/RegistrarEntrada', body);

        if (data.exito) {
            if (data.premioGanado) {
                document.getElementById('premio-nombre').textContent = data.nombreCliente;
                const modal = document.getElementById('modal-premio');
                modal.classList.remove('hidden'); modal.classList.add('flex');
            } else {
                toast(data.mensaje);
                setTimeout(() => location.reload(), 1200);
            }
        } else {
            alert(data.mensaje);
        }
    }

    async function registrarSalida() {
        const data = await postJson('/Acceso/RegistrarSalida?id=' + window.clienteActual.clienteId, {});
        if (data.exito) {
            toast(data.mensaje);
            setTimeout(() => location.reload(), 1200);
        } else {
            alert(data.mensaje);
        }
    }

    function cerrarPremio() {
        document.getElementById('modal-premio').classList.add('hidden');
        document.getElementById('modal-premio').classList.remove('flex');
        location.reload();
    }

    // ================= Estado en vivo del lector (polling) =================
    // El lector no notifica a la web; aquí se consulta su estado periódicamente
    // para que la tarjeta se actualice sola cuando se conecta/desconecta u ocupa.
    function pintarEstadoLector(estado) {
        const icono = document.getElementById('lector-icono');
        const nombre = document.getElementById('lector-nombre');
        const badge = document.getElementById('lector-estado-badge');
        if (!badge) return;

        const conectado = !!estado.lectorConectado;
        icono.className = 'material-symbols-outlined ' + (conectado ? 'text-tertiary' : 'text-error');
        badge.className = 'font-label-lg px-3 py-1 rounded-full ' +
            (conectado
                ? 'bg-tertiary-container/10 text-tertiary border border-tertiary/20'
                : 'bg-error-container text-on-error-container border border-error/20');
        badge.textContent = conectado ? 'Conectado' : 'Desconectado';
        if (conectado && estado.nombreDispositivo) nombre.textContent = estado.nombreDispositivo;
        badge.dataset.ocupado = estado.ocupado ? '1' : '0';
    }

    async function actualizarEstadoLector() {
        try {
            const resp = await fetch('/Dashboard/EstadoLector', {
                headers: { 'Accept': 'application/json', 'RequestVerificationToken': TOKEN }
            });
            if (!resp.ok) return;
            pintarEstadoLector(await resp.json());
        } catch { /* lector no disponible: la tarjeta conserva el último estado */ }
    }

    setInterval(actualizarEstadoLector, 4000);
    actualizarEstadoLector();
</script>
}
